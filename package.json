{
  "name": "reinex-app",
  "description": "Reinex - Platform for Managing Schedules and Customer Relations",
  "author": "Shaked Yossef",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:api && npm run lint:api-responses:strict-ux && npm run lint:error-tracking && npm run lint:sql && npm run lint:types && vite build",
    "dep:check": "madge --circular src --ts-config jsconfig.json",
    "check:schema": "node scripts/checkSchema.js",
    "lint": "eslint .",
    "lint:types": "node scripts/typecheck.js",
    "lint:types:strict": "node scripts/typecheck.js --strict",
    "lint:api": "eslint api/",
    "lint:sql": "node scripts/validate-setup-sql.js --format=text",
    "lint:sql:strict": "node scripts/validate-setup-sql.js --strict --format=text",
    "lint:sql:json": "node scripts/validate-setup-sql.js --format=json",
    "lint:sql:github": "node scripts/validate-setup-sql.js --format=github",
    "lint:upsert-conflicts": "node scripts/validate-upsert-conflicts.js",
    "lint:error-tracking": "node scripts/validate-error-tracking.js",
    "lint:error-tracking:strict": "node scripts/validate-error-tracking.js --strict",
    "lint:api-responses": "node scripts/validate-api-response-contracts.js",
    "lint:api-responses:strict-ux": "node scripts/validate-api-response-contracts.js --strict-ux",
    "lint:fix": "eslint . --fix",
    "validate:api": "node scripts/validate-api-endpoints.js",
    "test:finance-calendar": "node --test test/finance-preview-contract.test.js test/finance-calendar-workflows.test.js test/ledger-presentation.test.js api/_shared/BillingLedgerService.test.js api/_shared/student-billing.test.js",
    "audit:finance-calendar:fixture": "node scripts/audit-finance-calendar-invariants.js",
    "verify:beta": "npm run test:finance-calendar && npm run audit:finance-calendar:fixture && npm run build",
    "test:isolation-stress-test": "node --test implementations/database/one-db-refactor/isolation-stress-test.js",
    "test:validator": "node scripts/test-validator.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/resource": "^6.1.20",
    "@fullcalendar/resource-timegrid": "^6.1.20",
    "@fullcalendar/resource-timeline": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@refinedev/core": "^5.0.12",
    "@refinedev/react-router": "^2.0.4",
    "@refinedev/simple-rest": "^6.0.1",
    "@rjsf/core": "^6.4.1",
    "@rjsf/utils": "^6.4.1",
    "@rjsf/validator-ajv8": "^6.4.1",
    "@supabase/supabase-js": "^2.57.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jschardet": "^3.1.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.542.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "posthog-js": "^1.369.3",
    "react": "^19.1.1",
    "react-big-calendar": "^1.19.4",
    "react-day-picker": "^9.9.0",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-file-progress": "^3.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "madge": "^8.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.2",
    "wait-on": "^8.0.4"
  }
}
