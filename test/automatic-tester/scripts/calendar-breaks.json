{
  "meta": {
    "id": "calendar-breaks",
    "name": "Calendar Breaks — CRUD + UI",
    "description": "Full lifecycle test for instructor breaks: API CRUD (create, read, update, delete) via direct API calls, then UI smoke test — open the split-button dropdown, open AddBreakDialog, verify all form fields are present, and cancel.",
    "version": "1.0.0",
    "last_validated_at": "2026-05-26T09:09:11Z",
    "author": "claude-ai",
    "dependencies": {
      "routes": [
        "/calendar"
      ],
      "api_endpoints": [
        "GET /api/instructors",
        "POST /api/instructor-breaks",
        "GET /api/instructor-breaks",
        "PUT /api/instructor-breaks",
        "DELETE /api/instructor-breaks"
      ]
    }
  },
  "config": {
    "timeout_ms": 15000,
    "screenshot_on_failure": true,
    "continue_on_step_failure": false,
    "continue_on_workflow_failure": true
  },
  "variables": {
    "BREAK_DATE": "2026-06-02"
  },

  "workflows": [

    {
      "id": "login",
      "name": "Login as Admin",
      "steps": [
        {
          "id": "do-login",
          "description": "Sign in with admin credentials",
          "action": "login",
          "role": "admin"
        },
        {
          "id": "assert-dashboard",
          "description": "Confirm landing on dashboard",
          "action": "assert",
          "type": "url",
          "pattern": "#/dashboard"
        },
        {
          "id": "screenshot",
          "action": "screenshot",
          "name": "01-dashboard"
        }
      ]
    },

    {
      "id": "resolve-instructor",
      "name": "Resolve Test Instructor",
      "description": "Fetch the instructor roster and store the first instructor employee ID for use in API tests.",
      "steps": [
        {
          "id": "get-instructors",
          "description": "GET /api/instructors and store the first employee ID",
          "action": "apiCall",
          "method": "GET",
          "endpoint": "/api/instructors",
          "store": "INSTRUCTOR_ID",
          "storeField": "0.id"
        },
        {
          "id": "screenshot",
          "action": "screenshot",
          "name": "02-instructor-resolved"
        }
      ]
    },

    {
      "id": "api-crud",
      "name": "Instructor Breaks — API CRUD",
      "description": "Create a break via POST, verify it appears in GET, update it via PUT, then hard-delete it via DELETE.",
      "steps": [
        {
          "id": "create-break",
          "description": "POST /api/instructor-breaks — create a 30-minute break",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/instructor-breaks",
          "body": {
            "instructor_employee_id": "{{INSTRUCTOR_ID}}",
            "datetime_start": "{{BREAK_DATE}}T10:00:00.000Z",
            "duration_minutes": 30,
            "break_type": "break",
            "note": "בדיקה אוטומטית {{RUN_ID}}"
          },
          "store": "BREAK_ID",
          "storeField": "id"
        },
        {
          "id": "screenshot-after-create",
          "action": "screenshot",
          "name": "03-break-created"
        },
        {
          "id": "get-breaks",
          "description": "GET /api/instructor-breaks — verify the created break is returned in the date range",
          "action": "apiCall",
          "method": "GET",
          "endpoint": "/api/instructor-breaks?start_date={{BREAK_DATE}}&end_date={{BREAK_DATE}}&instructor_employee_id={{INSTRUCTOR_ID}}"
        },
        {
          "id": "update-break",
          "description": "PUT /api/instructor-breaks — update duration and note",
          "action": "apiCall",
          "method": "PUT",
          "endpoint": "/api/instructor-breaks",
          "body": {
            "id": "{{BREAK_ID}}",
            "duration_minutes": 45,
            "break_type": "meeting",
            "note": "עדכון בדיקה {{RUN_ID}}"
          }
        },
        {
          "id": "screenshot-after-update",
          "action": "screenshot",
          "name": "04-break-updated"
        },
        {
          "id": "delete-break",
          "description": "DELETE /api/instructor-breaks — hard-delete the break by ID",
          "action": "apiCall",
          "method": "DELETE",
          "endpoint": "/api/instructor-breaks?id={{BREAK_ID}}",
          "ignoreStatus": [204]
        },
        {
          "id": "screenshot-after-delete",
          "action": "screenshot",
          "name": "05-break-deleted"
        }
      ]
    },

    {
      "id": "calendar-ui",
      "name": "Calendar UI — Split Button and AddBreakDialog",
      "description": "Open the calendar page, open the 'add break' split-button dropdown, open the AddBreakDialog, verify all form fields are present, then close without saving.",
      "steps": [
        {
          "id": "navigate-calendar",
          "description": "Navigate to the calendar page",
          "action": "navigate",
          "url": "{{BASE_URL}}/#/calendar"
        },
        {
          "id": "wait-for-calendar",
          "description": "Wait for the calendar main content to appear",
          "action": "waitForSelector",
          "selector": "main, [role='main']"
        },
        {
          "id": "wait-for-new-lesson-button",
          "description": "Wait for the 'שיעור חדש' split button to appear",
          "action": "waitForSelector",
          "selector": "button:has-text('שיעור חדש')"
        },
        {
          "id": "screenshot-calendar",
          "action": "screenshot",
          "name": "06-calendar-loaded"
        },
        {
          "id": "click-break-dropdown",
          "description": "Click the chevron dropdown trigger next to 'שיעור חדש'",
          "action": "click",
          "selector": "[data-testid='calendar-add-break-trigger']"
        },
        {
          "id": "wait-for-break-menu-item",
          "description": "Wait for the 'הוסף הפסקה' menu item to appear",
          "action": "waitForSelector",
          "selector": "[role='menuitem']:has-text('הוסף הפסקה')"
        },
        {
          "id": "screenshot-dropdown-open",
          "action": "screenshot",
          "name": "07-break-dropdown-open"
        },
        {
          "id": "click-add-break",
          "description": "Click the 'הוסף הפסקה' menu item",
          "action": "click",
          "selector": "[role='menuitem']:has-text('הוסף הפסקה')"
        },
        {
          "id": "wait-for-dialog",
          "description": "Wait for the AddBreakDialog to open",
          "action": "waitForSelector",
          "selector": "[role='dialog']"
        },
        {
          "id": "assert-dialog-title",
          "description": "Verify the dialog title is 'הוסף הפסקה'",
          "action": "assert",
          "type": "text",
          "selector": "[role='dialog'] [data-slot='dialog-title'], [role='dialog'] h2",
          "value": "הוסף הפסקה"
        },
        {
          "id": "assert-instructor-select",
          "description": "Verify the instructor selector field is visible",
          "action": "assert",
          "type": "visible",
          "selector": "#break-instructor"
        },
        {
          "id": "assert-date-input",
          "description": "Verify the date input field is visible",
          "action": "assert",
          "type": "visible",
          "selector": "#break-date"
        },
        {
          "id": "assert-start-time-input",
          "description": "Verify the start time input is visible",
          "action": "assert",
          "type": "visible",
          "selector": "#break-start-time"
        },
        {
          "id": "assert-duration-select",
          "description": "Verify the duration selector is visible",
          "action": "assert",
          "type": "visible",
          "selector": "#break-duration"
        },
        {
          "id": "screenshot-dialog-open",
          "action": "screenshot",
          "name": "08-add-break-dialog"
        },
        {
          "id": "close-dialog",
          "description": "Close the dialog by clicking the Cancel button",
          "action": "click",
          "selector": "[role='dialog'] button:has-text('ביטול')"
        },
        {
          "id": "wait-for-dialog-close",
          "description": "Verify the dialog closes",
          "action": "waitForSelector",
          "selector": "[role='dialog']",
          "state": "hidden"
        },
        {
          "id": "screenshot-after-close",
          "action": "screenshot",
          "name": "09-dialog-closed"
        }
      ]
    },

    {
      "id": "logout",
      "name": "Logout",
      "steps": [
        {
          "id": "do-logout",
          "action": "logout"
        },
        {
          "id": "assert-login-page",
          "action": "assert",
          "type": "url",
          "pattern": "#/login"
        },
        {
          "id": "screenshot",
          "action": "screenshot",
          "name": "10-logged-out"
        }
      ]
    }

  ]
}
