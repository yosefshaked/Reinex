    {
      "id": "ui-org-dialog",
      "name": "UI – One \"חופשה\" tile; two steps; one save writes both keys; one history shows both",
      "steps": [
        {
          "id": "navigate",
          "action": "navigate",
          "url": "{{BASE_URL}}/#/Settings"
        },
        {
          "id": "wait-tile",
          "action": "waitForSelector",
          "selector": "button:has-text('פתיחת הגדרות חופשה')"
        },
        {
          "id": "assert-old-tiles-gone",
          "action": "assert",
          "type": "count",
          "selector": "button:has-text('פתיחת הגדרות תשלום חופשה'), button:has-text('פתיחת הגדרות ימי חופשה')",
          "value": "0"
        },
        {
