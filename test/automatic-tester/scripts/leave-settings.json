{
  "meta": {
    "id": "leave-settings",
    "name": "Leave — the organisation's \"חופשה\" settings and the employee's \"חופשה\" row",
    "description": "Leave is set in one place per level. Settings page: one tile \"חופשה\" opens one dialog with two steps — step 1 \"כמה ימי חופשה מגיעים בשנה?\" (leave_entitlement_policy: \"כמות קבועה\" with a table per seniority year, the default and listed first, or \"מומלץ: לפי ותק וימי עבודה\") and, once step 1 has a choice, step 2 \"כמה משלמים על יום חופשה?\" (leave_pay_policy: \"ממוצע מומלץ\" — 3 months by calendar days, no months to set — or \"ממוצע היסטורי\" with its months). Both are dated settings: one \"בתוקף מ-\", one save that writes a version of each key that changed, and one \"היסטוריה\" that lists both, labelled. Per employee: the \"נוכחות\" tab has a \"חופשה\" row next to the balance (\"ימים: ... · תשלום: ...\") with one \"שינוי\" that opens the same two steps (Employees.annual_leave_days, Employees.leave_pay_method); the \"פיננסים\" tab has no leave box. The run resets both defaults through the API (and checks the server refuses bad values), creates an instructor who started on 2020-01-01 with no lessons (the recommended count gives 0 days so far), switches the organisation to \"כמות קבועה\" + \"ממוצע היסטורי\" in one save and reads the history, sees the instructor follow it, sets 9 days and \"ממוצע מומלץ\" for the instructor, goes back to the defaults, and restores the organisation defaults in the dialog. The words \"לפי החוק\" appear nowhere.",
    "version": "2.0.0",
    "last_validated_at": "2026-11-18T13:00:00Z",
    "author": "claude-ai",
    "dependencies": {
      "routes": [
        "/Settings",
        "/employees"
      ],
      "api_endpoints": [
        "GET /api/settings",
        "POST /api/settings",
        "POST /api/instructors",
        "PUT /api/instructors",
        "GET /api/employee-leave"
      ]
    }
  },
  "config": {
    "timeout_ms": 25000,
    "screenshot_on_failure": true,
    "continue_on_step_failure": false,
    "continue_on_workflow_failure": false
  },
  "workflows": [
    {
      "id": "login",
      "name": "Login as Admin",
      "steps": [
        {
          "id": "do-login",
          "action": "login",
          "role": "admin"
        },
        {
          "id": "assert-dashboard",
          "action": "assert",
          "type": "url",
          "pattern": "#/dashboard"
        }
      ]
    },
    {
      "id": "api-setup",
      "name": "API – Both defaults reset from today; bad values refused; an instructor who started in 2020",
      "steps": [
        {
          "id": "reset-both",
          "description": "Store the recommended count and the seeded pay default from today in one request (replacing today's versions of an earlier run)",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/settings",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "settings": {
              "leave_entitlement_policy": {
                "value": {
                  "mode": "legal"
                },
                "effective_date": "{{TODAY}}"
              },
              "leave_pay_policy": {
                "value": {
                  "default_method": "legal",
                  "lookback_months": 3,
                  "fixed_rate_default": 0
                },
                "effective_date": "{{TODAY}}"
              }
            }
          }
        },
        {
          "id": "refuse-without-date",
          "description": "A dated setting needs effective_date (400 missing_effective_date)",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/settings",
          "ignoreStatus": [
            400
          ],
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "settings": {
              "leave_pay_policy": {
                "default_method": "avg_hourly_x_avg_day_hours",
                "lookback_months": 3
              }
            }
          }
        },
        {
          "id": "refuse-13-months",
          "description": "13 months is refused (400); the dialog below re-checks the stored value is still 3 months",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/settings",
          "ignoreStatus": [
            400
          ],
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "settings": {
              "leave_pay_policy": {
                "value": {
                  "default_method": "legal",
                  "lookback_months": 13
                },
                "effective_date": "{{TODAY}}"
              }
            }
          }
        },
        {
          "id": "refuse-bad-table",
          "description": "A fixed table with a negative row is refused (400 invalid_leave_entitlement_table); the dialog below still opens on the recommended count",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/settings",
          "ignoreStatus": [
            400
          ],
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "settings": {
              "leave_entitlement_policy": {
                "value": {
                  "mode": "fixed",
                  "fixed_days_by_year": [
                    -1
                  ]
                },
                "effective_date": "{{TODAY}}"
              }
            }
          }
        },
        {
          "id": "create-instructor",
          "description": "An instructor employed since 2020-01-01 with no lessons yet: 0 days so far this year",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/instructors",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "first_name": "זכאות",
            "last_name": "בדיקה {{RUN_NUMERIC_ID}}",
            "employee_id": "TEST-LEAVE-{{RUN_NUMERIC_ID}}",
            "employee_type": "instructor",
            "start_date": "2020-01-01"
          },
          "store": "LEAVE_INSTRUCTOR_ID",
          "storeField": "id"
        }
      ]
    },
    {
      "id": "ui-employee-defaults",
      "name": "UI – The instructor follows both defaults; one \"חופשה\" row in \"נוכחות\", nothing in \"פיננסים\"",
      "steps": [
        {
