          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-leave-step='1'] input[name='leave-entitlement-mode'] >> nth=0 >> xpath=self::*[@id='leave-entitlement-mode-fixed']"
        },
        {
          "id": "assert-legal-listed-second",
          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-leave-step='1'] input[name='leave-entitlement-mode'] >> nth=1 >> xpath=self::*[@id='leave-entitlement-mode-legal']"
