{
  "meta": {
    "id": "leave-entitlement",
    "name": "Leave entitlement — the organisation default and a manual number per employee",
    "description": "How many leave days an employee is owed. leave_entitlement_policy is a dated setting (\"ימי חופשה\" tile in the settings page): \"לפי החוק\" (computed from seniority and days worked) or \"כמות קבועה\" (a table per seniority year). Per employee, the \"נוכחות\" tab shows \"מגיעים N ימי חופשה השנה · נוצלו X · נשארו Y\" with \"הסבר מלא\" and \"שינוי\" (the organisation default, or a fixed number a year, stored in Employees.annual_leave_days). The run resets the default to the law, creates an instructor who started on 2020-01-01 with no lessons (the law gives 0 days), switches the default to \"כמות קבועה\" in the settings dialog and sees the instructor's line change, sets a manual 9 days from the \"נוכחות\" tab and reads \"הסבר מלא\", goes back to the default, and finally restores the law through the API.",
    "version": "1.0.0",
    "last_validated_at": "2026-11-16T12:00:00Z",
    "author": "claude-ai",
    "dependencies": {
      "routes": [
        "/Settings",
        "/employees"
      ],
      "api_endpoints": [
        "GET /api/settings",
        "POST /api/settings",
        "POST /api/instructors",
        "PUT /api/instructors",
        "GET /api/employee-leave"
      ]
    }
  },
  "config": {
    "timeout_ms": 25000,
    "screenshot_on_failure": true,
    "continue_on_step_failure": false,
    "continue_on_workflow_failure": false
  },
  "workflows": [
    {
      "id": "login",
      "name": "Login as Admin",
      "steps": [
        { "id": "do-login", "action": "login", "role": "admin" },
        { "id": "assert-dashboard", "action": "assert", "type": "url", "pattern": "#/dashboard" }
      ]
    },

    {
      "id": "api-setup",
      "name": "API – The default is the law; an instructor who started in 2020",
      "steps": [
        {
          "id": "reset-policy",
          "description": "Store \"לפי החוק\" from today (replacing today's version of an earlier run)",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/settings",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "settings": {
              "leave_entitlement_policy": { "value": { "mode": "legal" }, "effective_date": "{{TODAY}}" }
            }
          }
        },
        {
          "id": "refuse-bad-table",
          "description": "A fixed table with a negative row is refused (400 invalid_leave_entitlement_table); the dialog below still opens on \"לפי החוק\"",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/settings",
          "ignoreStatus": [400],
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "settings": {
              "leave_entitlement_policy": { "value": { "mode": "fixed", "fixed_days_by_year": [-1] }, "effective_date": "{{TODAY}}" }
            }
          }
        },
        {
          "id": "create-instructor",
          "description": "An instructor employed since 2020-01-01 with no lessons yet: by law 0 days so far this year",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/instructors",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "first_name": "זכאות",
            "last_name": "בדיקה {{RUN_NUMERIC_ID}}",
            "employee_id": "TEST-LEAVE-{{RUN_NUMERIC_ID}}",
            "employee_type": "instructor",
            "start_date": "2020-01-01"
          },
          "store": "LEAVE_INSTRUCTOR_ID",
          "storeField": "id"
        }
      ]
    },

    {
      "id": "ui-law-line",
      "name": "UI – Under the law the instructor's line shows 0 days and the plain explanation",
      "steps": [
        { "id": "navigate-employees", "action": "navigate", "url": "{{BASE_URL}}/#/employees" },
        { "id": "wait-main", "action": "waitForSelector", "selector": "main, [role='main']" },
        { "id": "open-employee", "action": "click", "selector": "button:has-text('זכאות בדיקה {{RUN_NUMERIC_ID}}')", "first": true },
        { "id": "open-attendance-tab", "action": "click", "selector": "[role='tab']:has-text('נוכחות')" },
        {
          "id": "assert-law-line",
          "description": "No days worked yet this year: nothing is owed so far",
          "action": "waitForSelector",
          "selector": "[data-leave-balance-line]:has-text('מגיעים 0 ימי חופשה השנה · נוצלו 0 · נשארו 0')"
        },
        { "id": "open-explain", "action": "click", "selector": "[data-leave-explain-open]" },
        {
          "id": "assert-law-explain",
          "description": "Plain sentences: the seniority year, a full year's days, the days worked so far and the 200-day rule",
          "action": "waitForSelector",
          "selector": "[data-leave-explain]:has-text('בשנה מלאה מגיעים'):has-text('שנה מלאה היא 200 ימי עבודה')"
        },
        {
          "id": "assert-law-assumptions",
          "action": "waitForSelector",
          "selector": "[data-leave-explain]:has-text('חלקי ימים מעוגלים כלפי מטה')"
        },
        { "id": "screenshot-law", "action": "screenshot", "name": "01-leave-entitlement-law" },
        { "id": "close-explain", "action": "pressKey", "key": "Escape" }
      ]
    },

    {
      "id": "ui-org-fixed",
      "name": "UI – Switch the organisation default to \"כמות קבועה\" in the settings dialog",
      "steps": [
        { "id": "navigate", "action": "navigate", "url": "{{BASE_URL}}/#/Settings" },
        { "id": "open-dialog", "action": "click", "selector": "button:has-text('פתיחת הגדרות ימי חופשה')" },
        {
          "id": "assert-disclaimer",
          "description": "The owner's one-line advice is at the top of the dialog",
          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-leave-entitlement-disclaimer]:has-text('בהתייעצות עם רואה החשבון')"
        },
        {
          "id": "wait-legal-selected",
          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-settings-block='leave-entitlement-default'] #leave-entitlement-mode-legal:checked"
        },
        {
          "id": "assert-save-disabled",
          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-settings-block='leave-entitlement-default'] button:has-text('שמירה')[disabled]"
        },
        { "id": "choose-fixed", "action": "click", "selector": "[role='dialog'] label[for='leave-entitlement-mode-fixed']" },
        {
          "id": "assert-table-prefilled",
          "description": "The table opens prefilled with the 5-day table; the last row means \"and onwards\"",
          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-leave-entitlement-table] label:has-text('שנה 14 ואילך')"
        },
        {
          "id": "assert-year-1",
          "action": "assert",
          "type": "value",
          "selector": "[role='dialog'] #leave-entitlement-year-1",
          "value": "12"
        },
        { "id": "screenshot-fixed", "action": "screenshot", "name": "02-leave-entitlement-fixed-table" },
        { "id": "save", "action": "click", "selector": "[role='dialog'] [data-settings-block='leave-entitlement-default'] button:has-text('שמירה'):not([disabled])" },
        { "id": "wait-dialog-closed", "action": "assert", "type": "hidden", "selector": "[role='dialog'] [data-settings-block='leave-entitlement-default']" }
      ]
    },

    {
      "id": "ui-line-follows-org",
      "name": "UI – The instructor's line follows the organisation's table",
      "steps": [
        { "id": "navigate-employees", "action": "navigate", "url": "{{BASE_URL}}/#/employees" },
        { "id": "wait-main", "action": "waitForSelector", "selector": "main, [role='main']" },
        { "id": "open-employee", "action": "click", "selector": "button:has-text('זכאות בדיקה {{RUN_NUMERIC_ID}}')", "first": true },
        { "id": "open-attendance-tab", "action": "click", "selector": "[role='tab']:has-text('נוכחות')" },
        { "id": "wait-line", "action": "waitForSelector", "selector": "[data-leave-balance-line]:has-text('ימי חופשה השנה')" },
        {
          "id": "assert-not-zero",
          "description": "Seniority year 7 or more in the default table is at least 15 days, so the line no longer says 0",
          "action": "assert",
          "type": "count",
          "selector": "[data-leave-balance-line]:has-text('מגיעים 0 ימי')",
          "value": "0"
        },
        { "id": "open-explain", "action": "click", "selector": "[data-leave-explain-open]" },
        {
          "id": "assert-fixed-explain",
          "action": "waitForSelector",
          "selector": "[data-leave-explain]:has-text('לפי ההגדרה של הארגון:')"
        },
        { "id": "close-explain", "action": "pressKey", "key": "Escape" }
      ]
    },

    {
      "id": "ui-manual-number",
      "name": "UI – A manual number for the instructor from the \"נוכחות\" tab, then back to the default",
      "steps": [
        { "id": "open-change", "action": "click", "selector": "[data-leave-entitlement-change]" },
        { "id": "choose-manual", "action": "click", "selector": "[data-leave-entitlement-choice] [data-choice='manual']" },
        { "id": "fill-days", "action": "fill", "selector": "[data-leave-entitlement-choice] #leave-entitlement-days", "value": "9" },
        { "id": "save", "action": "click", "selector": "[data-leave-entitlement-choice] button:has-text('שמירה'):not([disabled])" },
        {
          "id": "assert-manual-line",
          "action": "waitForSelector",
          "selector": "[data-leave-balance-line]:has-text('מגיעים 9 ימי חופשה השנה')"
        },
        { "id": "open-explain", "action": "click", "selector": "[data-leave-explain-open]" },
        {
          "id": "assert-manual-explain",
          "description": "The full explanation says it was set by hand, and how to add or remove days",
          "action": "waitForSelector",
          "selector": "[data-leave-explain]:has-text('נקבע ידנית לעובד/ת: 9 ימי חופשה בשנה.'):has-text('שינוי יתרה')"
        },
        { "id": "screenshot-manual", "action": "screenshot", "name": "03-leave-entitlement-manual" },
        { "id": "close-explain", "action": "pressKey", "key": "Escape" },
        { "id": "open-change-again", "action": "click", "selector": "[data-leave-entitlement-change]" },
        { "id": "choose-default", "action": "click", "selector": "[data-leave-entitlement-choice] [data-choice='default']" },
        { "id": "save-default", "action": "click", "selector": "[data-leave-entitlement-choice] button:has-text('שמירה'):not([disabled])" },
        {
          "id": "wait-back-to-org",
          "description": "The line is reread and follows the organisation's table again (no longer 9 days)",
          "action": "waitForSelector",
          "selector": "[data-leave-balance-line]:has-text('ימי חופשה השנה'):not(:has-text('מגיעים 9 ימי'))"
        },
        { "id": "open-explain-again", "action": "click", "selector": "[data-leave-explain-open]" },
        {
          "id": "assert-org-explain-again",
          "action": "waitForSelector",
          "selector": "[data-leave-explain]:has-text('לפי ההגדרה של הארגון:')"
        },
        { "id": "close-explain-again", "action": "pressKey", "key": "Escape" }
      ]
    },

    {
      "id": "api-restore",
      "name": "API – Restore the law as the organisation default",
      "steps": [
        {
          "id": "restore-policy",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/settings",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "settings": {
              "leave_entitlement_policy": { "value": { "mode": "legal" }, "effective_date": "{{TODAY}}" }
            }
          }
        },
        {
          "id": "read-balance",
          "description": "The API answers with the entitlement of the year",
          "action": "apiCall",
          "method": "GET",
          "endpoint": "/api/employee-leave?org_id={{TEST_ORG_ID}}&employee_id={{LEAVE_INSTRUCTOR_ID}}",
          "store": "LEAVE_SOURCE",
          "storeField": "entitlement.source"
        }
      ]
    },

    {
      "id": "logout",
      "name": "Logout",
      "steps": [
        { "id": "do-logout", "action": "logout" },
        { "id": "assert-login-page", "action": "assert", "type": "url", "pattern": "#/login" }
      ]
    }
  ]
}
