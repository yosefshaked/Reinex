{
  "meta": {
    "id": "student-lifecycle",
    "name": "Student Lifecycle",
    "description": "Full lifecycle: admin creates a waiting-list intake, approves it to create a student, assigns an instructor, adds a lesson template, views the student's profile, and verifies the student appears in the roster.",
    "version": "1.0.0",
    "last_validated_at": "2026-04-23T23:59:00Z",
    "author": "claude-ai",
    "dependencies": {
      "routes": [
        "/dashboard",
        "/waiting-list",
        "/students-list",
        "/students/:id/:tab?"
      ],
      "api_endpoints": [
        "GET /api/dashboard-tasks",
        "GET /api/students-list",
        "GET /api/waiting-list"
      ]
    }
  },
  "config": {
    "timeout_ms": 15000,
    "screenshot_on_failure": true,
    "continue_on_step_failure": false,
    "continue_on_workflow_failure": true
  },
  "variables": {
    "STUDENT_FIRST": "טסט",
    "STUDENT_LAST":  "אוטומטי",
    "STUDENT_ID":    "999000001",
    "STUDENT_PHONE": "0501234567",
    "STUDENT_DOB":   "2010-01-15"
  },

  "workflows": [

    {
      "id": "login-as-admin",
      "name": "Login as Admin",
      "description": "Sign in with the admin account and land on the dashboard.",
      "steps": [
        {
          "id": "do-login",
          "description": "Sign in with admin credentials",
          "action": "login",
          "role": "admin"
        },
        {
          "id": "assert-dashboard",
          "description": "Verify we are on the dashboard",
          "action": "assert",
          "type": "url",
          "pattern": "#/dashboard"
        },
        {
          "id": "screenshot-dashboard",
          "description": "Capture dashboard state",
          "action": "screenshot",
          "name": "01-dashboard"
        }
      ]
    },

    {
      "id": "create-waiting-list-intake",
      "name": "Create Waiting-List Intake",
      "description": "Admin navigates to the waiting list and opens the new-intake form, fills in student details, and submits.",
      "steps": [
        {
          "id": "navigate-waiting-list",
          "description": "Go to the waiting list page",
          "action": "navigate",
          "url": "{{BASE_URL}}/#/waiting-list"
        },
        {
          "id": "assert-waiting-list-loaded",
          "description": "Confirm waiting list page is visible",
          "action": "waitForSelector",
          "selector": "main, [role='main'], #main-content, .page-content",
          "state": "visible"
        },
        {
          "id": "screenshot-waiting-list",
          "description": "Capture waiting list before adding intake",
          "action": "screenshot",
          "name": "02-waiting-list"
        },
        {
          "id": "click-add-intake",
          "description": "Click the button that opens the new intake dialog (look for plus / add / new buttons)",
          "action": "click",
          "selector": "button:has-text('הוסף'), button:has-text('חדש'), button:has-text('+'), [aria-label*='הוסף'], [aria-label*='חדש']"
        },
        {
          "id": "wait-for-dialog",
          "description": "Wait for the intake dialog / drawer to open",
          "action": "waitForSelector",
          "selector": "[role='dialog'], [data-radix-popper-content-wrapper], .dialog-content",
          "state": "visible"
        },
        {
          "id": "fill-first-name",
          "description": "Enter the student's first name",
          "action": "fill",
          "selector": "input[name='firstName'], input[name='first_name'], input[placeholder*='שם פרטי'], input[placeholder*='שם']",
          "value": "{{STUDENT_FIRST}}"
        },
        {
          "id": "fill-last-name",
          "description": "Enter the student's last name",
          "action": "fill",
          "selector": "input[name='lastName'], input[name='last_name'], input[placeholder*='שם משפחה']",
          "value": "{{STUDENT_LAST}}"
        },
        {
          "id": "fill-id-number",
          "description": "Enter the student's ID number",
          "action": "fill",
          "selector": "input[name='identityNumber'], input[name='identity_number'], input[placeholder*='תעודת זהות'], input[placeholder*='ת.ז']",
          "value": "{{STUDENT_ID}}"
        },
        {
          "id": "fill-phone",
          "description": "Enter the student's phone number",
          "action": "fill",
          "selector": "input[name='phone'], input[type='tel'], input[placeholder*='טלפון']",
          "value": "{{STUDENT_PHONE}}"
        },
        {
          "id": "screenshot-filled-form",
          "description": "Capture intake form before submitting",
          "action": "screenshot",
          "name": "03-intake-form-filled"
        },
        {
          "id": "submit-intake",
          "description": "Submit the intake form",
          "action": "click",
          "selector": "button[type='submit'], button:has-text('שמור'), button:has-text('הוסף'), button:has-text('צור')"
        },
        {
          "id": "wait-for-success",
          "description": "Wait for confirmation (dialog closes or a success toast appears)",
          "action": "waitForSelector",
          "selector": "[data-sonner-toast], .toast, [role='status'], [aria-live='polite']",
          "state": "visible"
        },
        {
          "id": "screenshot-after-intake",
          "description": "Capture state after intake was submitted",
          "action": "screenshot",
          "name": "04-intake-submitted"
        }
      ]
    },

    {
      "id": "approve-intake",
      "name": "Approve the Intake (Convert to Active Student)",
      "description": "Admin finds the newly created intake in the waiting list and approves it, which creates an active student record.",
      "steps": [
        {
          "id": "navigate-waiting-list-2",
          "description": "Return to the waiting list",
          "action": "navigate",
          "url": "{{BASE_URL}}/#/waiting-list"
        },
        {
          "id": "wait-for-intake-row",
          "description": "Wait for a row matching the submitted student name",
          "action": "waitForSelector",
          "selector": "tr:has-text('{{STUDENT_FIRST}}'), li:has-text('{{STUDENT_FIRST}}'), [data-testid*='intake']:has-text('{{STUDENT_FIRST}}')"
        },
        {
          "id": "screenshot-intake-in-list",
          "description": "Capture the intake visible in the waiting list",
          "action": "screenshot",
          "name": "05-intake-in-waiting-list"
        },
        {
          "id": "click-approve-button",
          "description": "Click the approve button for this intake",
          "action": "click",
          "selector": "tr:has-text('{{STUDENT_FIRST}}') button:has-text('אישור'), tr:has-text('{{STUDENT_FIRST}}') button:has-text('אשר'), tr:has-text('{{STUDENT_FIRST}}') [aria-label*='אשר']"
        },
        {
          "id": "wait-for-approval-dialog",
          "description": "Wait for approval confirmation dialog",
          "action": "waitForSelector",
          "selector": "[role='dialog'], .dialog-content",
          "state": "visible"
        },
        {
          "id": "confirm-approval",
          "description": "Confirm the approval in the dialog",
          "action": "click",
          "selector": "[role='dialog'] button:has-text('אשר'), [role='dialog'] button:has-text('אישור'), [role='dialog'] button[type='submit']"
        },
        {
          "id": "wait-after-approval",
          "description": "Wait for the approval to complete (dialog closes)",
          "action": "waitForSelector",
          "selector": "[role='dialog']",
          "state": "hidden"
        },
        {
          "id": "screenshot-after-approval",
          "description": "Capture state after approval",
          "action": "screenshot",
          "name": "06-after-approval"
        }
      ]
    },

    {
      "id": "verify-student-in-roster",
      "name": "Verify Student Appears in Roster",
      "description": "Navigate to the students list and confirm the newly created student is visible.",
      "steps": [
        {
          "id": "navigate-students-list",
          "description": "Go to the students list page",
          "action": "navigate",
          "url": "{{BASE_URL}}/#/students-list"
        },
        {
          "id": "wait-for-list-load",
          "description": "Wait for the student list table to appear",
          "action": "waitForSelector",
          "selector": "table, [role='table'], ul[class*='student'], .student-list"
        },
        {
          "id": "assert-student-present",
          "description": "Confirm the student name appears in the list",
          "action": "assert",
          "type": "visible",
          "selector": "tr:has-text('{{STUDENT_FIRST}}'), li:has-text('{{STUDENT_FIRST}}'), [data-testid*='student']:has-text('{{STUDENT_FIRST}}')"
        },
        {
          "id": "screenshot-student-in-list",
          "description": "Capture students list showing new student",
          "action": "screenshot",
          "name": "07-student-in-roster"
        }
      ]
    },

    {
      "id": "view-student-profile",
      "name": "View Student Profile",
      "description": "Click into the student's profile and verify key tabs are accessible.",
      "steps": [
        {
          "id": "click-student-row",
          "description": "Open the student's profile page",
          "action": "click",
          "selector": "tr:has-text('{{STUDENT_FIRST}}') a, tr:has-text('{{STUDENT_FIRST}}') td:first-child, li:has-text('{{STUDENT_FIRST}}')"
        },
        {
          "id": "wait-for-profile",
          "description": "Wait for the profile page to load",
          "action": "waitForURL",
          "pattern": "#/students/"
        },
        {
          "id": "assert-student-name-visible",
          "description": "Confirm student name appears on the profile",
          "action": "assert",
          "type": "visible",
          "selector": "h1:has-text('{{STUDENT_FIRST}}'), h2:has-text('{{STUDENT_FIRST}}'), [class*='title']:has-text('{{STUDENT_FIRST}}')"
        },
        {
          "id": "screenshot-profile",
          "description": "Capture student profile page",
          "action": "screenshot",
          "name": "08-student-profile"
        }
      ]
    }

  ]
}
