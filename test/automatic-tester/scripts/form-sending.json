{
  "meta": {
    "id": "form-sending",
    "name": "Form Sending",
    "description": "Tests sending forms from every entry point in the app: student header (WhatsApp), student forms tab (email), one-time customers (WhatsApp), and service-required forms with shared contact resolution.",
    "version": "1.2.0",
    "last_validated_at": "2026-05-24T13:51:46Z",
    "author": "claude-ai",
    "dependencies": {
      "routes": [
        "/students/:id/:tab?",
        "/one-time-customers/:clientProfileId"
      ],
      "api_endpoints": [
        "POST /api/forms",
        "PUT /api/forms/:id",
        "POST /api/services",
        "POST /api/students-list",
        "GET /api/students-list",
        "POST /api/client-profiles",
        "POST /api/student-required-forms/send",
        "GET /api/student-required-forms/load",
        "POST /api/student-required-forms/submit"
      ]
    }
  },
  "config": {
    "timeout_ms": 20000,
    "screenshot_on_failure": true,
    "continue_on_step_failure": false,
    "continue_on_workflow_failure": true
  },
  "variables": {
    "STUDENT_FIRST": "טסט",
    "STUDENT_LAST": "אוטומטי",
    "STUDENT_ID": "999000001",
    "STUDENT_PHONE": "0501234500",
    "STUDENT_EMAIL": "autotest.student@reinex-test.local",
    "FORM_NAME": "טופס בדיקה אוטומטי",
    "REQUIRED_FORM_NAME": "טופס חובה בדיקה אוטומטי",
    "REQUIRED_SERVICE_NAME": "שירות טופס חובה אוטומטי",
    "REQUIRED_FORM_LABEL": "אישור חובה אוטומטי",
    "CLIENT_FIRST": "לקוח",
    "CLIENT_LAST": "חד פעמי",
    "CLIENT_PHONE": "0501234599",
    "CLIENT_ID": "999000005"
  },
  "workflows": [
    {
      "id": "login",
      "name": "Login",
      "description": "Sign in as admin.",
      "steps": [
        {
          "id": "login-admin",
          "action": "login",
          "role": "admin",
          "description": "Log in as admin"
        }
      ]
    },
    {
      "id": "api-setup-form",
      "name": "API – Create and publish a test form",
      "description": "Creates a form template and publishes it so it appears in the SendFormDialog template list.",
      "steps": [
        {
          "id": "create-form",
          "action": "apiCall",
          "description": "Create a test form template",
          "method": "POST",
          "endpoint": "/api/forms",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "name": "{{FORM_NAME}}",
            "blocks": []
          },
          "store": "FORM_ID",
          "storeField": "id"
        },
        {
          "id": "publish-form",
          "action": "apiCall",
          "description": "Publish the form so it appears in the SendFormDialog template list",
          "method": "PUT",
          "endpoint": "/api/forms/{{FORM_ID}}",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "action": "publish"
          }
        }
      ]
    },
    {
      "id": "api-setup-student",
      "name": "API – Create or fetch the test student",
      "description": "Ensures the standard test student exists and resolves their UUID.",
      "steps": [
        {
          "id": "create-student",
          "action": "apiCall",
          "description": "Create test student – ignore 409 if they already exist",
          "method": "POST",
          "endpoint": "/api/students-list",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "first_name": "{{STUDENT_FIRST}}",
            "last_name": "{{STUDENT_LAST}}",
            "identity_number": "{{STUDENT_ID}}",
            "phone": "{{STUDENT_PHONE}}",
            "email": "{{STUDENT_EMAIL}}"
          },
          "ignoreStatus": [409]
        },
        {
          "id": "get-student-id",
          "action": "apiCall",
          "description": "GET student list to resolve UUID (works regardless of 201 or 409 above)",
          "method": "GET",
          "endpoint": "/api/students-list?org_id={{TEST_ORG_ID}}&q={{STUDENT_ID}}",
          "store": "STUDENT_UUID",
          "storeField": "0.id",
          "stores": [
            { "variable": "STUDENT_CLIENT_PROFILE_ID", "field": "0.client_profile_id" }
          ]
        },
        {
          "id": "ensure-student-email",
          "action": "apiCall",
          "description": "PUT to ensure the test student has an email (handles pre-existing students created without one)",
          "method": "PUT",
          "endpoint": "/api/students-list/{{STUDENT_UUID}}",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "email": "{{STUDENT_EMAIL}}"
          }
        }
      ]
    },
    {
      "id": "api-setup-client",
      "name": "API – Create a one-time customer",
      "description": "Creates a client profile for use in the one-time customer send test.",
      "steps": [
        {
          "id": "create-client",
          "action": "apiCall",
          "description": "Create or reuse a one-time customer (client profile) – API always returns the profile",
          "method": "POST",
          "endpoint": "/api/client-profiles",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "first_name": "{{CLIENT_FIRST}}",
            "last_name": "{{CLIENT_LAST}}",
            "identity_number": "{{CLIENT_ID}}",
            "phone": "{{CLIENT_PHONE}}"
          },
          "store": "CLIENT_PROFILE_ID",
          "storeField": "id"
        },
        {
          "id": "seed-client-history",
          "action": "apiCall",
          "description": "Seed a form submission so the client appears in the one-time-customers segment (requires lesson or form history)",
          "method": "POST",
          "endpoint": "/api/form-submissions",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "form_id": "{{FORM_ID}}",
            "client_profile_id": "{{CLIENT_PROFILE_ID}}",
            "delivery_method": "whatsapp"
          },
          "ignoreStatus": [400, 409, 500, 502]
        }
      ]
    },
    {
      "id": "api-setup-required-form",
      "name": "API – Create and publish a required-form template",
      "description": "Creates a required-form template and publishes it so it can be attached to a service.",
      "steps": [
        {
          "id": "create-required-form",
          "action": "apiCall",
          "description": "Create a required-form template",
          "method": "POST",
          "endpoint": "/api/forms",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "name": "{{REQUIRED_FORM_NAME}}",
            "form_usage": "required_form"
          },
          "store": "REQUIRED_FORM_ID",
          "storeField": "id"
        },
        {
          "id": "publish-required-form",
          "action": "apiCall",
          "description": "Publish the required form so invite delivery can use the canonical published schema",
          "method": "PUT",
          "endpoint": "/api/forms/{{REQUIRED_FORM_ID}}",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "action": "publish"
          }
        }
      ]
    },
    {
      "id": "api-setup-required-service",
      "name": "API – Create a service with a required form",
      "description": "Creates a service whose required_forms config points at the published required-form template.",
      "steps": [
        {
          "id": "create-required-service",
          "action": "apiCall",
          "description": "Create a service with a required form attached",
          "method": "POST",
          "endpoint": "/api/services",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "name": "{{REQUIRED_SERVICE_NAME}}",
            "duration_minutes": 45,
            "payment_model": "fixed_rate",
            "required_forms": [
              {
                "form_id": "{{REQUIRED_FORM_ID}}",
                "label": "{{REQUIRED_FORM_LABEL}}",
                "enforcement": "warn",
                "allow_resubmit": true
              }
            ]
          },
          "store": "REQUIRED_SERVICE_ID",
          "storeField": "id"
        }
      ]
    },
    {
      "id": "required-form-send-submit-api",
      "name": "Required form send and public submit",
      "description": "Exercises the service-required form flow: send invite, load public invite, and submit through the required-form public endpoint.",
      "steps": [
        {
          "id": "send-required-form",
          "action": "apiCall",
          "description": "Send the required form invite by WhatsApp for the test student, relying on shared contact resolution rather than an explicit phone override",
          "method": "POST",
          "endpoint": "/api/student-required-forms/send",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "service_id": "{{REQUIRED_SERVICE_ID}}",
            "form_id": "{{REQUIRED_FORM_ID}}",
            "client_profile_id": "{{STUDENT_CLIENT_PROFILE_ID}}",
            "student_id": "{{STUDENT_UUID}}",
            "delivery_method": "whatsapp"
          },
          "stores": [
            { "variable": "REQUIRED_FORM_INVITE_TOKEN", "field": "invite_token" },
            { "variable": "REQUIRED_FORM_SUBMISSION_ID", "field": "submission_id" }
          ]
        },
        {
          "id": "load-required-form-invite",
          "action": "apiCall",
          "description": "Load the public required-form invite payload",
          "method": "GET",
          "endpoint": "/api/student-required-forms/load?invite={{REQUIRED_FORM_INVITE_TOKEN}}",
          "store": "REQUIRED_FORM_INVITE_FLOW",
          "storeField": "flow"
        },
        {
          "id": "submit-required-form",
          "action": "apiCall",
          "description": "Submit the required form through the public invite endpoint",
          "method": "POST",
          "endpoint": "/api/student-required-forms/submit",
          "body": {
            "invite_token": "{{REQUIRED_FORM_INVITE_TOKEN}}",
            "answers": {}
          }
        }
      ]
    },
    {
      "id": "send-from-student-header",
      "name": "Send form from student header (WhatsApp)",
      "description": "Opens the SendFormDialog via the student header button, selects the test form, chooses WhatsApp, and verifies an OTP code appears.",
      "steps": [
        {
          "id": "navigate-to-student",
          "action": "navigate",
          "url": "{{BASE_URL}}/#/students/{{STUDENT_UUID}}/overview",
          "description": "Navigate to student overview"
        },
        {
          "id": "wait-student-loaded",
          "action": "waitForSelector",
          "selector": "button:has-text('שלח טופס')",
          "description": "Wait for the student header send button to appear"
        },
        {
          "id": "click-send-form-header",
          "action": "click",
          "selector": "button:has-text('שלח טופס')",
          "first": true,
          "description": "Click the 'שלח טופס' button in the student header"
        },
        {
          "id": "wait-dialog-open",
          "action": "waitForSelector",
          "selector": "[role='dialog']",
          "description": "Wait for SendFormDialog to open"
        },
        {
          "id": "wait-templates-loaded",
          "action": "waitForSelector",
          "selector": "[role='dialog'] button[role='combobox']",
          "description": "Wait for the template selector to appear in the dialog"
        },
        {
          "id": "open-template-dropdown",
          "action": "click",
          "selector": "[role='dialog'] button[role='combobox']",
          "first": true,
          "description": "Open the form template dropdown"
        },
        {
          "id": "select-test-form",
          "action": "click",
          "selector": "[role='option']:has-text('{{FORM_NAME}}')",
          "first": true,
          "description": "Select our published test form template"
        },
        {
          "id": "delivery-already-whatsapp",
          "action": "assert",
          "type": "visible",
          "selector": "[role='dialog'] button[role='combobox']:has-text('וואטסאפ')",
          "description": "Delivery method defaults to WhatsApp – assert it's selected"
        },
        {
          "id": "click-send",
          "action": "click",
          "selector": "[role='dialog'] button:has-text('שלח טופס')",
          "description": "Click the send button"
        },
        {
          "id": "wait-for-send-api",
          "action": "waitForNetwork",
          "pattern": "/api/form-submissions",
          "description": "Wait for the form-submissions API to respond before asserting the result",
          "timeout": 15000
        },
        {
          "id": "assert-otp-appears",
          "action": "assert",
          "type": "text",
          "selector": "[role='dialog']",
          "value": "קוד אימות:",
          "description": "Verify that an OTP code is shown – confirms WhatsApp routing succeeded"
        },
        {
          "id": "screenshot-whatsapp-otp",
          "action": "screenshot",
          "name": "form-send-whatsapp-otp"
        },
        {
          "id": "close-dialog",
          "action": "click",
          "selector": "[role='dialog'] button:has-text('סגור')",
          "description": "Close the dialog"
        }
      ]
    },
    {
      "id": "send-from-student-forms-tab",
      "name": "Send form from student forms tab (email)",
      "description": "Navigates to the forms tab, opens SendFormDialog via the tab-level button, switches to email, and verifies the success message.",
      "steps": [
        {
          "id": "navigate-to-forms-tab",
          "action": "navigate",
          "url": "{{BASE_URL}}/#/students/{{STUDENT_UUID}}/forms",
          "description": "Navigate directly to the student forms tab"
        },
        {
          "id": "wait-forms-tab-loaded",
          "action": "waitForSelector",
          "selector": "[role='tabpanel'] button:has-text('שלח טופס')",
          "description": "Wait for the forms tab send button to appear inside the tab panel"
        },
        {
          "id": "click-send-form-in-tab",
          "action": "click",
          "selector": "[role='tabpanel'] button:has-text('שלח טופס')",
          "first": true,
          "description": "Click the 'שלח טופס' button inside the forms tab panel"
        },
        {
          "id": "wait-dialog-open",
          "action": "waitForSelector",
          "selector": "[role='dialog']",
          "description": "Wait for SendFormDialog to open"
        },
        {
          "id": "open-template-dropdown",
          "action": "click",
          "selector": "[role='dialog'] button[role='combobox']",
          "first": true,
          "description": "Open the form template dropdown"
        },
        {
          "id": "select-test-form",
          "action": "click",
          "selector": "[role='option']:has-text('{{FORM_NAME}}')",
          "first": true,
          "description": "Select our published test form"
        },
        {
          "id": "open-delivery-dropdown",
          "action": "click",
          "selector": "[role='dialog'] button[role='combobox']:has-text('וואטסאפ')",
          "description": "Open the delivery method dropdown (currently WhatsApp)"
        },
        {
          "id": "select-email",
          "action": "click",
          "selector": "[role='option']:has-text('אימייל')",
          "first": true,
          "description": "Switch delivery method to email"
        },
        {
          "id": "click-send",
          "action": "click",
          "selector": "[role='dialog'] button:has-text('שלח טופס')",
          "description": "Click the send button"
        },
        {
          "id": "wait-for-send-api",
          "action": "waitForNetwork",
          "pattern": "/api/form-submissions",
          "description": "Wait for the form-submissions API to respond (proves the email path was triggered)",
          "timeout": 15000
        },
        {
          "id": "sleep-after-send",
          "action": "sleep",
          "ms": 1000,
          "description": "Let the dialog settle (email delivery success/failure depends on local Brevo config)"
        },
        {
          "id": "screenshot-email-result",
          "action": "screenshot",
          "name": "form-send-email-result",
          "description": "Capture dialog state – shows success if Brevo is configured, or form still open if not"
        },
        {
          "id": "close-dialog",
          "action": "click",
          "selector": "[role='dialog'] button:has-text('סגור')",
          "description": "Close the dialog"
        }
      ]
    },
    {
      "id": "send-from-one-time-customer",
      "name": "Send form from one-time customer page (WhatsApp)",
      "description": "Navigates to the one-time customer detail page, opens SendFormDialog, and verifies OTP code appears for WhatsApp delivery.",
      "steps": [
        {
          "id": "navigate-to-client",
          "action": "navigate",
          "url": "{{BASE_URL}}/#/one-time-customers/{{CLIENT_PROFILE_ID}}",
          "description": "Navigate directly to the one-time customer detail page"
        },
        {
          "id": "wait-client-page-loaded",
          "action": "waitForSelector",
          "selector": "button:has-text('שלח טופס')",
          "description": "Wait for the send form button on the client page"
        },
        {
          "id": "click-send-form",
          "action": "click",
          "selector": "button:has-text('שלח טופס')",
          "first": true,
          "description": "Click the 'שלח טופס' button on the one-time customer page"
        },
        {
          "id": "wait-dialog-open",
          "action": "waitForSelector",
          "selector": "[role='dialog']",
          "description": "Wait for SendFormDialog to open"
        },
        {
          "id": "open-template-dropdown",
          "action": "click",
          "selector": "[role='dialog'] button[role='combobox']",
          "first": true,
          "description": "Open the form template dropdown"
        },
        {
          "id": "select-test-form",
          "action": "click",
          "selector": "[role='option']:has-text('{{FORM_NAME}}')",
          "first": true,
          "description": "Select our published test form"
        },
        {
          "id": "delivery-already-whatsapp",
          "action": "assert",
          "type": "visible",
          "selector": "[role='dialog'] button[role='combobox']:has-text('וואטסאפ')",
          "description": "Delivery defaults to WhatsApp"
        },
        {
          "id": "click-send",
          "action": "click",
          "selector": "[role='dialog'] button:has-text('שלח טופס')",
          "description": "Click the send button"
        },
        {
          "id": "wait-for-send-api",
          "action": "waitForNetwork",
          "pattern": "/api/form-submissions",
          "description": "Wait for the form-submissions API to respond",
          "timeout": 15000
        },
        {
          "id": "assert-otp-appears",
          "action": "assert",
          "type": "text",
          "selector": "[role='dialog']",
          "value": "קוד אימות:",
          "description": "Verify OTP code appears – confirms WhatsApp routing succeeded"
        },
        {
          "id": "screenshot-client-whatsapp",
          "action": "screenshot",
          "name": "form-send-client-whatsapp-otp"
        },
        {
          "id": "close-dialog",
          "action": "click",
          "selector": "[role='dialog'] button:has-text('סגור')",
          "description": "Close the dialog"
        }
      ]
    }
  ]
}
