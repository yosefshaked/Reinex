{
  "meta": {
    "id": "hmo-claiming",
    "name": "HMO Claiming – End to End",
    "description": "Full HMO claiming flow: create provider + track → assign authorization to student → create lesson → mark attended → open financials claims tab → create draft batch → submit batch.",
    "version": "1.0.0",
    "last_validated_at": "2026-04-27T00:00:00Z",
    "author": "claude-ai",
    "dependencies": {
      "routes": [
        "/financials"
      ],
      "api_endpoints": [
        "POST /api/instructors",
        "GET /api/services",
        "POST /api/students-list",
        "GET /api/students-list",
        "POST /api/settings/medical-providers",
        "POST /api/hmo-authorizations",
        "POST /api/lesson-instances",
        "PUT /api/calendar-attendance",
        "POST /api/billing"
      ]
    }
  },
  "config": {
    "timeout_ms": 25000,
    "screenshot_on_failure": true,
    "continue_on_step_failure": false,
    "continue_on_workflow_failure": true
  },
  "variables": {
    "HMO_STUDENT_FIRST": "תלמיד",
    "HMO_STUDENT_LAST": "קופת חולים",
    "HMO_STUDENT_ID": "999000002",
    "HMO_STUDENT_PHONE": "0501234502",
    "HMO_PROVIDER_NAME": "קופת חולים בדיקה",
    "HMO_TRACK_NAME": "מסלול בדיקה",
    "LESSON_DATETIME": "2026-04-01T08:00:00.000Z",
    "LESSON_DURATION": "45"
  },
  "workflows": [
    {
      "id": "login",
      "name": "Login",
      "description": "Sign in as admin.",
      "steps": [
        {
          "id": "login-admin",
          "action": "login",
          "role": "admin",
          "description": "Log in as admin"
        }
      ]
    },
    {
      "id": "api-setup-service",
      "name": "API – Resolve service ID",
      "description": "Fetches the first available service to use for the HMO track and lesson instance.",
      "steps": [
        {
          "id": "get-service",
          "action": "apiCall",
          "description": "Fetch the first available service to use for the HMO track and lesson",
          "method": "GET",
          "endpoint": "/api/services?org_id={{TEST_ORG_ID}}",
          "store": "SERVICE_ID",
          "storeField": "0.id"
        }
      ]
    },
    {
      "id": "api-setup-instructor",
      "name": "API – Create a test instructor employee",
      "description": "Creates a standalone instructor employee and sets a service capability (base_rate=0) by inserting directly into Supabase so the instructor rate validation passes during attendance marking.",
      "steps": [
        {
          "id": "create-instructor",
          "action": "apiCall",
          "description": "Create a standalone instructor employee for use in the test lesson",
          "method": "POST",
          "endpoint": "/api/instructors",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "first_name": "מדריך",
            "last_name": "בדיקה",
            "employee_id": "TEST-INST-99",
            "employee_type": "instructor",
            "payroll_model": "lesson_based",
            "current_rate": 20000
          },
          "store": "INSTRUCTOR_ID",
          "storeField": "id"
        },
        {
          "id": "set-instructor-service-rate-direct",
          "action": "apiCall",
          "description": "Direct Supabase INSERT to set base_rate=0 capability for the service – bypasses the PostgREST onConflict constraint issue in local dev. Ignores 409 if the row already exists.",
          "method": "POST",
          "endpoint": "http://127.0.0.1:54331/rest/v1/instructor_service_capabilities",
          "headers": {
            "apikey": "{{SERVICE_ROLE_KEY}}",
            "Prefer": "return=minimal"
          },
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "employee_id": "{{INSTRUCTOR_ID}}",
            "service_id": "{{SERVICE_ID}}",
            "base_rate": 0,
            "max_students": 1,
            "availability_windows": [],
            "metadata": {}
          },
          "ignoreStatus": [409]
        }
      ]
    },
    {
      "id": "api-setup-student",
      "name": "API – Create or fetch the HMO test student",
      "description": "Ensures the HMO test student exists and resolves their UUID.",
      "steps": [
        {
          "id": "create-student",
          "action": "apiCall",
          "description": "Create HMO test student – ignore 409 if already exists",
          "method": "POST",
          "endpoint": "/api/students-list",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "first_name": "{{HMO_STUDENT_FIRST}}",
            "last_name": "{{HMO_STUDENT_LAST}}",
            "identity_number": "{{HMO_STUDENT_ID}}",
            "phone": "{{HMO_STUDENT_PHONE}}"
          },
          "ignoreStatus": [409]
        },
        {
          "id": "get-student-id",
          "action": "apiCall",
          "description": "GET student list to resolve UUID (handles both 201 and 409 above)",
          "method": "GET",
          "endpoint": "/api/students-list?org_id={{TEST_ORG_ID}}&q={{HMO_STUDENT_ID}}",
          "store": "HMO_STUDENT_UUID",
          "storeField": "0.id"
        }
      ]
    },
    {
      "id": "api-setup-provider-track",
      "name": "API – Create HMO provider and track",
      "description": "Creates a new HMO provider and a track linked to the first available service. Gracefully handles re-runs by ignoring 409 and resolving IDs from GET.",
      "steps": [
        {
          "id": "create-provider",
          "action": "apiCall",
          "description": "Create a new HMO provider (ignore 409 if already exists)",
          "method": "POST",
          "endpoint": "/api/settings/medical-providers",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "entity": "provider",
            "name": "{{HMO_PROVIDER_NAME}}",
            "is_active": true
          },
          "ignoreStatus": [409]
        },
        {
          "id": "resolve-provider-id",
          "action": "apiCall",
          "description": "GET providers and resolve HMO_PROVIDER_ID by name (works after both 201 and 409)",
          "method": "GET",
          "endpoint": "/api/settings/medical-providers?org_id={{TEST_ORG_ID}}",
          "store": "HMO_PROVIDER_ID",
          "storeField": "providers.[name={{HMO_PROVIDER_NAME}}].id"
        },
        {
          "id": "create-track",
          "action": "apiCall",
          "description": "Create a track under the HMO provider (ignore 409 if already exists)",
          "method": "POST",
          "endpoint": "/api/settings/medical-providers",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "entity": "track",
            "provider_id": "{{HMO_PROVIDER_ID}}",
            "service_id": "{{SERVICE_ID}}",
            "name": "{{HMO_TRACK_NAME}}",
            "payment_mode": "fully_paid_by_hmo",
            "default_customer_charge_amount": 0,
            "default_insurer_claim_amount": 10000,
            "default_post_coverage_policy": "service_default"
          },
          "ignoreStatus": [409]
        },
        {
          "id": "resolve-track-id",
          "action": "apiCall",
          "description": "GET providers and resolve HMO_TRACK_ID by name (works after both 201 and 409)",
          "method": "GET",
          "endpoint": "/api/settings/medical-providers?org_id={{TEST_ORG_ID}}",
          "store": "HMO_TRACK_ID",
          "storeField": "providers.[name={{HMO_PROVIDER_NAME}}].tracks.[name={{HMO_TRACK_NAME}}].id"
        }
      ]
    },
    {
      "id": "api-setup-authorization",
      "name": "API – Assign HMO authorization to the student",
      "description": "Creates an active HMO authorization tying the student to the provider track. Gracefully handles re-runs: ignores 409 (overlap conflict) and 500, then fetches the authorization ID via GET.",
      "steps": [
        {
          "id": "create-authorization",
          "action": "apiCall",
          "description": "Create an active HMO authorization – ignore 409/500 if one already exists",
          "method": "POST",
          "endpoint": "/api/hmo-authorizations",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "student_id": "{{HMO_STUDENT_UUID}}",
            "provider_id": "{{HMO_PROVIDER_ID}}",
            "provider_track_id": "{{HMO_TRACK_ID}}",
            "authorized_lessons": 10,
            "status": "active"
          },
          "ignoreStatus": [409, 500]
        },
        {
          "id": "resolve-authorization-id",
          "action": "apiCall",
          "description": "GET authorizations to resolve AUTHORIZATION_ID (works after both 201 and 409/500)",
          "method": "GET",
          "endpoint": "/api/hmo-authorizations?org_id={{TEST_ORG_ID}}&student_id={{HMO_STUDENT_UUID}}",
          "store": "AUTHORIZATION_ID",
          "storeField": "authorizations.0.id"
        }
      ]
    },
    {
      "id": "api-setup-lesson",
      "name": "API – Create lesson instance and mark student as attended",
      "description": "Creates a past lesson with the HMO student, marks them attended, which triggers the billing ledger entry that will be claimed.",
      "steps": [
        {
          "id": "create-lesson",
          "action": "apiCall",
          "description": "Create a lesson instance with the HMO student as participant",
          "method": "POST",
          "endpoint": "/api/lesson-instances",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "datetime_start": "{{LESSON_DATETIME}}",
            "duration_minutes": 45,
            "instructor_employee_id": "{{INSTRUCTOR_ID}}",
            "service_id": "{{SERVICE_ID}}",
            "student_ids": ["{{HMO_STUDENT_UUID}}"]
          },
          "stores": [
            { "variable": "LESSON_INSTANCE_ID", "field": "id" },
            { "variable": "LESSON_PARTICIPANT_ID", "field": "participants.0.id" }
          ]
        },
        {
          "id": "mark-attended",
          "action": "apiCall",
          "description": "Mark the student as attended – triggers HMO billing ledger entry creation",
          "method": "POST",
          "endpoint": "/api/calendar/attendance",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "instance_id": "{{LESSON_INSTANCE_ID}}",
            "participant_id": "{{LESSON_PARTICIPANT_ID}}",
            "participant_status": "attended"
          }
        },
        {
          "id": "wait-for-ledger",
          "action": "sleep",
          "ms": 2000,
          "description": "Allow billing sync to complete before checking the claims UI"
        }
      ]
    },
    {
      "id": "ui-claims-navigate",
      "name": "UI – Open financials claims tab",
      "description": "Navigates to the financials page and switches to the HMO claims tab.",
      "steps": [
        {
          "id": "navigate-to-financials",
          "action": "navigate",
          "url": "{{BASE_URL}}/#/financials",
          "description": "Navigate to the financials page"
        },
        {
          "id": "click-claims-tab",
          "action": "click",
          "selector": "button[role='tab']:has-text('תביעות HMO')",
          "description": "Switch to the HMO claims tab"
        },
        {
          "id": "wait-claims-loaded",
          "action": "waitForSelector",
          "selector": "h3:has-text('יצירת דרישת HMO')",
          "description": "Wait for the claim creation panel to appear"
        },
        {
          "id": "screenshot-claims-tab",
          "action": "screenshot",
          "name": "hmo-claims-tab"
        }
      ]
    },
    {
      "id": "ui-claims-create-batch",
      "name": "UI – Select claimable rows and create draft batch",
      "description": "Clicks the provider card to select its claimable rows, then creates a draft batch.",
      "steps": [
        {
          "id": "click-provider-rows",
          "action": "click",
          "selector": "button:has-text('{{HMO_PROVIDER_NAME}}')",
          "first": true,
          "description": "Click the provider card to select all claimable rows for our test provider"
        },
        {
          "id": "wait-rows-selected",
          "action": "waitForSelector",
          "selector": "button:has-text('צור טיוטה מ')",
          "description": "Wait for the 'create draft' button to show selected row count"
        },
        {
          "id": "click-create-batch",
          "action": "click",
          "selector": "button:has-text('צור טיוטה מ')",
          "description": "Click to create the draft batch"
        },
        {
          "id": "sleep-after-create",
          "action": "sleep",
          "ms": 1500,
          "description": "Wait for the batch to appear in the list after creation"
        },
        {
          "id": "assert-batch-visible",
          "action": "assert",
          "type": "visible",
          "selector": "button:has-text('סמן כנשלח')",
          "description": "Assert that the newly created draft batch shows the submit button"
        },
        {
          "id": "screenshot-batch-created",
          "action": "screenshot",
          "name": "hmo-batch-created"
        }
      ]
    },
    {
      "id": "ui-claims-submit-batch",
      "name": "UI – Submit the draft batch",
      "description": "Opens the submit dialog, confirms, and verifies the batch is no longer in draft state.",
      "steps": [
        {
          "id": "click-submit-batch",
          "action": "click",
          "selector": "button:has-text('סמן כנשלח')",
          "first": true,
          "description": "Click 'סמן כנשלח' on the draft batch to open the submit dialog"
        },
        {
          "id": "wait-submit-dialog",
          "action": "waitForSelector",
          "selector": "[role='dialog']",
          "description": "Wait for the submit dialog to open"
        },
        {
          "id": "confirm-submit",
          "action": "click",
          "selector": "[role='dialog'] button:has-text('סמן כנשלח')",
          "description": "Confirm submission in the dialog"
        },
        {
          "id": "wait-dialog-closed",
          "action": "waitForSelector",
          "selector": "[role='dialog']",
          "state": "hidden",
          "description": "Wait for the dialog to close after successful submission"
        },
        {
          "id": "assert-no-draft-button",
          "action": "assert",
          "type": "visible",
          "selector": "button:has-text('סמן כנשלח')",
          "not": true,
          "description": "After submission, no more draft batches remain with the submit button"
        },
        {
          "id": "screenshot-batch-submitted",
          "action": "screenshot",
          "name": "hmo-batch-submitted"
        }
      ]
    }
  ]
}
