{
  "meta": {
    "id": "hmo-claiming",
    "name": "HMO Claiming – End to End",
    "description": "Full HMO claiming flow: create provider + track → assign authorization to student → create lesson → mark attended → open financials claims tab → create draft batch → submit batch.",
    "version": "1.0.1",
    "last_validated_at": "2026-05-25T12:25:27Z",
    "author": "claude-ai",
    "dependencies": {
      "routes": [
        "/financials"
      ],
      "api_endpoints": [
        "POST /api/instructors",
        "GET /api/services",
        "POST /api/students-list",
        "GET /api/students-list",
        "POST /api/settings/medical-providers",
        "POST /api/hmo-authorizations",
        "POST /api/lesson-instances",
        "PUT /api/calendar-attendance",
        "POST /api/billing"
      ]
    }
  },
  "config": {
    "timeout_ms": 25000,
    "screenshot_on_failure": true,
    "continue_on_step_failure": false,
    "continue_on_workflow_failure": true
  },
  "variables": {
    "HMO_STUDENT_FIRST": "תלמיד",
    "HMO_STUDENT_LAST": "קופת חולים",
    "HMO_STUDENT_ID": "999000002",
    "HMO_STUDENT_PHONE": "0501234502",
    "HMO_PROVIDER_NAME": "קופת חולים בדיקה",
    "HMO_TRACK_NAME": "מסלול בדיקה",
    "LESSON_DURATION": "45"
  },
  "workflows": [
    {
      "id": "login",
      "name": "Login",
      "description": "Sign in as admin.",
      "steps": [
        {
          "id": "login-admin",
          "action": "login",
          "role": "admin",
          "description": "Log in as admin"
        }
      ]
    },
    {
      "id": "api-setup-service",
      "name": "API – Resolve service ID",
      "description": "Fetches the first available service to use for the HMO track and lesson instance, then ensures it has a billable default price so ledger-backed HMO claims can be created.",
      "steps": [
        {
          "id": "get-service",
          "action": "apiCall",
          "description": "Fetch the first available service to use for the HMO track and lesson",
          "method": "GET",
          "endpoint": "/api/services?org_id={{TEST_ORG_ID}}",
          "store": "SERVICE_ID",
          "storeField": "0.id"
        },
        {
          "id": "ensure-service-price-direct",
          "action": "apiCall",
          "description": "Direct Supabase PATCH to ensure the selected service has a default customer charge. Billing blocks lesson ledger creation when this is missing, even for fully HMO-covered lessons.",
          "method": "PATCH",
          "endpoint": "{{SUPABASE_URL}}/rest/v1/Services?id=eq.{{SERVICE_ID}}&org_id=eq.{{TEST_ORG_ID}}",
          "headers": {
            "apikey": "{{SERVICE_ROLE_KEY}}",
            "Prefer": "return=minimal"
          },
          "body": {
            "default_customer_charge_amount": 10000,
            "payment_model": "fixed_rate"
          }
        }
      ]
    },
    {
      "id": "api-setup-instructor",
      "name": "API – Create a test instructor employee",
      "description": "Creates a standalone instructor employee and sets a service capability (base_rate=0) by inserting directly into Supabase so the instructor rate validation passes during attendance marking.",
      "steps": [
        {
          "id": "create-instructor",
          "action": "apiCall",
          "description": "Create a standalone instructor employee for use in the test lesson",
          "method": "POST",
          "endpoint": "/api/instructors",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "first_name": "מדריך",
            "last_name": "בדיקה",
            "employee_id": "TEST-INST-99",
            "employee_type": "instructor",
            "payroll_model": "lesson_based",
            "current_rate": 20000
          },
          "store": "INSTRUCTOR_ID",
          "storeField": "id"
        },
        {
          "id": "set-instructor-service-rate-direct",
          "action": "apiCall",
          "description": "Direct Supabase INSERT to set base_rate=0 capability for the service – bypasses the PostgREST onConflict constraint issue in local dev. Ignores 409 if the row already exists.",
          "method": "POST",
          "endpoint": "{{SUPABASE_URL}}/rest/v1/instructor_service_capabilities",
          "headers": {
            "apikey": "{{SERVICE_ROLE_KEY}}",
            "Prefer": "return=minimal"
          },
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "employee_id": "{{INSTRUCTOR_ID}}",
            "service_id": "{{SERVICE_ID}}",
            "base_rate": 0,
            "max_students": 1,
            "availability_windows": [],
            "metadata": {}
          },
          "ignoreStatus": [409]
        }
      ]
    },
    {
      "id": "api-setup-student",
      "name": "API – Create or fetch the HMO test student",
      "description": "Ensures the HMO test student exists and resolves their UUID.",
      "steps": [
        {
          "id": "create-student",
          "action": "apiCall",
          "description": "Create HMO test student – ignore 409 if already exists",
          "method": "POST",
          "endpoint": "/api/students-list",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "first_name": "{{HMO_STUDENT_FIRST}}",
            "last_name": "{{HMO_STUDENT_LAST}} {{RUN_ID}}",
            "identity_number": "999{{RUN_NUMERIC_ID}}",
            "phone": "{{HMO_STUDENT_PHONE}}"
          },
          "store": "HMO_STUDENT_UUID",
          "storeField": "id"
        }
      ]
    },
    {
      "id": "api-setup-provider-track",
      "name": "API – Create HMO provider and track",
      "description": "Creates a new HMO provider and a track linked to the first available service. Gracefully handles re-runs by ignoring 409 and resolving IDs from GET.",
      "steps": [
        {
          "id": "create-provider",
          "action": "apiCall",
          "description": "Create a new HMO provider (ignore 409 if already exists)",
          "method": "POST",
          "endpoint": "/api/settings/medical-providers",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "entity": "provider",
            "name": "{{HMO_PROVIDER_NAME}} {{RUN_ID}}",
            "is_active": true
          },
          "ignoreStatus": [409]
        },
        {
          "id": "resolve-provider-id",
          "action": "apiCall",
          "description": "GET providers and resolve HMO_PROVIDER_ID by name (works after both 201 and 409)",
          "method": "GET",
          "endpoint": "/api/settings/medical-providers?org_id={{TEST_ORG_ID}}",
          "store": "HMO_PROVIDER_ID",
          "storeField": "providers.[name={{HMO_PROVIDER_NAME}} {{RUN_ID}}].id"
        },
        {
          "id": "create-track",
          "action": "apiCall",
          "description": "Create a track under the HMO provider (ignore 409 if already exists)",
          "method": "POST",
          "endpoint": "/api/settings/medical-providers",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "entity": "track",
            "provider_id": "{{HMO_PROVIDER_ID}}",
            "service_id": "{{SERVICE_ID}}",
            "name": "{{HMO_TRACK_NAME}} {{RUN_ID}}",
            "payment_mode": "fully_paid_by_hmo",
            "default_customer_charge_amount": 0,
            "default_insurer_claim_amount": 10000,
            "default_post_coverage_policy": "service_default"
          },
          "ignoreStatus": [409]
        },
        {
          "id": "resolve-track-id",
          "action": "apiCall",
          "description": "GET providers and resolve HMO_TRACK_ID by name (works after both 201 and 409)",
          "method": "GET",
          "endpoint": "/api/settings/medical-providers?org_id={{TEST_ORG_ID}}",
          "store": "HMO_TRACK_ID",
          "storeField": "providers.[name={{HMO_PROVIDER_NAME}} {{RUN_ID}}].tracks.[name={{HMO_TRACK_NAME}} {{RUN_ID}}].id"
        }
      ]
    },
    {
      "id": "api-setup-authorization",
      "name": "API – Assign HMO authorization to the student",
      "description": "Creates an active HMO authorization tying the student to the provider track. Gracefully handles re-runs: ignores 409 (overlap conflict) and 500, then fetches the authorization ID via GET.",
      "steps": [
        {
          "id": "create-authorization",
          "action": "apiCall",
          "description": "Create an active HMO authorization – ignore 409/500 if one already exists",
          "method": "POST",
          "endpoint": "/api/hmo-authorizations",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "student_id": "{{HMO_STUDENT_UUID}}",
            "provider_id": "{{HMO_PROVIDER_ID}}",
            "provider_track_id": "{{HMO_TRACK_ID}}",
            "authorized_lessons": 10,
            "status": "active"
          },
          "ignoreStatus": [409, 500]
        },
        {
          "id": "resolve-authorization-id",
          "action": "apiCall",
          "description": "GET authorizations to resolve AUTHORIZATION_ID (works after both 201 and 409/500)",
          "method": "GET",
          "endpoint": "/api/hmo-authorizations?org_id={{TEST_ORG_ID}}&student_id={{HMO_STUDENT_UUID}}",
          "store": "AUTHORIZATION_ID",
          "storeField": "authorizations.0.id"
        }
      ]
    },
    {
      "id": "api-setup-lesson-current",
      "name": "API – Create lesson in current month and mark attended",
      "description": "Creates a lesson on the first of the current month ({{CURRENT_MONTH_START}}), marks the HMO student attended. This lesson will be claimable without navigating away from the default month view.",
      "steps": [
        {
          "id": "create-lesson-current",
          "action": "apiCall",
          "description": "Create a lesson instance in the current month",
          "method": "POST",
          "endpoint": "/api/lesson-instances",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "datetime_start": "{{CURRENT_MONTH_START}}",
            "duration_minutes": 45,
            "instructor_employee_id": "{{INSTRUCTOR_ID}}",
            "service_id": "{{SERVICE_ID}}",
            "student_ids": ["{{HMO_STUDENT_UUID}}"]
          },
          "stores": [
            { "variable": "CURR_INSTANCE_ID",   "field": "id" },
            { "variable": "CURR_PARTICIPANT_ID", "field": "participants.0.id" }
          ]
        },
        {
          "id": "mark-attended-current",
          "action": "apiCall",
          "description": "Mark the student attended for the current-month lesson",
          "method": "POST",
          "endpoint": "/api/calendar/attendance",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "instance_id": "{{CURR_INSTANCE_ID}}",
            "participant_id": "{{CURR_PARTICIPANT_ID}}",
            "participant_status": "attended"
          }
        }
      ]
    },
    {
      "id": "api-setup-lesson-prev",
      "name": "API – Create lesson in previous month and mark attended",
      "description": "Creates a lesson on the first of the previous month ({{PREV_MONTH_START}}), marks the HMO student attended. This lesson will only be visible after clicking 'הקודם' in the UI.",
      "steps": [
        {
          "id": "create-lesson-prev",
          "action": "apiCall",
          "description": "Create a lesson instance in the previous month",
          "method": "POST",
          "endpoint": "/api/lesson-instances",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "datetime_start": "{{PREV_MONTH_START}}",
            "duration_minutes": 45,
            "instructor_employee_id": "{{INSTRUCTOR_ID}}",
            "service_id": "{{SERVICE_ID}}",
            "student_ids": ["{{HMO_STUDENT_UUID}}"]
          },
          "stores": [
            { "variable": "PREV_INSTANCE_ID",   "field": "id" },
            { "variable": "PREV_PARTICIPANT_ID", "field": "participants.0.id" }
          ]
        },
        {
          "id": "mark-attended-prev",
          "action": "apiCall",
          "description": "Mark the student attended for the previous-month lesson",
          "method": "POST",
          "endpoint": "/api/calendar/attendance",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "instance_id": "{{PREV_INSTANCE_ID}}",
            "participant_id": "{{PREV_PARTICIPANT_ID}}",
            "participant_status": "attended"
          }
        },
        {
          "id": "wait-for-ledger",
          "action": "sleep",
          "ms": 2000,
          "description": "Allow both billing ledger entries to sync before opening the UI"
        }
      ]
    },
    {
      "id": "ui-claims-navigate",
      "name": "UI – Open financials claims tab",
      "description": "Navigates to the financials page and switches to the funder claims tab. The page defaults to the current month.",
      "steps": [
        {
          "id": "navigate-to-financials",
          "action": "navigate",
          "url": "{{BASE_URL}}/#/financials",
          "description": "Navigate to the financials page"
        },
        {
          "id": "click-claims-tab",
          "action": "click",
          "selector": "button[role='tab']:has-text('תביעות גורם מממן')",
          "description": "Switch to the funder claims tab"
        },
        {
          "id": "wait-claims-loaded",
          "action": "waitForSelector",
          "selector": "h3:has-text('שורות מוכנות לדרישה')",
          "description": "Wait for the claimable rows panel to appear"
        },
        {
          "id": "screenshot-claims-tab",
          "action": "screenshot",
          "name": "hmo-claims-tab-current-month"
        }
      ]
    },
    {
      "id": "ui-claims-current-month",
      "name": "UI – Claim current month's lesson",
      "description": "Selects the current-month claimable row, creates a draft batch, submits it, and verifies no draft remains. Page is already on the current month.",
      "steps": [
        {
          "id": "curr-select-all",
          "action": "click",
          "selector": "div:has(button:has-text('{{HMO_PROVIDER_NAME}} {{RUN_ID}}')) button:has-text('בחר הכל')",
          "description": "Select all claimable rows for the HMO provider in the current month"
        },
        {
          "id": "curr-wait-create-button",
          "action": "waitForSelector",
          "selector": "button:has-text('צור טיוטה מ')",
          "description": "Wait for the create-draft button to appear with a row count"
        },
        {
          "id": "curr-create-batch",
          "action": "click",
          "selector": "button:has-text('צור טיוטה מ')",
          "description": "Create the draft batch for current month"
        },
        {
          "id": "curr-sleep-after-create",
          "action": "sleep",
          "ms": 1500,
          "description": "Wait for the batch to appear in the list"
        },
        {
          "id": "curr-assert-submit-visible",
          "action": "assert",
          "type": "visible",
          "selector": "button:has-text('שלח לגורם מממן')",
          "description": "Assert the newly created draft batch shows the submit button"
        },
        {
          "id": "curr-click-submit",
          "action": "click",
          "selector": "button:has-text('שלח לגורם מממן')",
          "first": true,
          "description": "Open the submit dialog for the current-month draft batch"
        },
        {
          "id": "curr-wait-dialog",
          "action": "waitForSelector",
          "selector": "[role='dialog']",
          "description": "Wait for the submit dialog to open"
        },
        {
          "id": "curr-confirm-submit",
          "action": "click",
          "selector": "[role='dialog'] button:has-text('סמן כנשלח')",
          "description": "Confirm submission in the dialog"
        },
        {
          "id": "curr-wait-dialog-closed",
          "action": "waitForSelector",
          "selector": "[role='dialog']",
          "state": "hidden",
          "description": "Wait for the dialog to close after submission"
        },
        {
          "id": "curr-assert-no-submit",
          "action": "assert",
          "type": "visible",
          "selector": "button:has-text('שלח לגורם מממן')",
          "not": true,
          "description": "No more draft batches with a submit button remain in the current month"
        },
        {
          "id": "screenshot-current-submitted",
          "action": "screenshot",
          "name": "hmo-current-month-submitted"
        }
      ]
    },
    {
      "id": "ui-claims-prev-month",
      "name": "UI – Navigate to previous month and claim its lesson",
      "description": "Clicks 'הקודם' to go to the previous month, verifies the prev-month lesson appears as claimable, then creates and submits a draft batch. This validates that month navigation works correctly.",
      "steps": [
        {
          "id": "click-prev-month",
          "action": "click",
          "selector": "button:has-text('הקודם')",
          "description": "Navigate to the previous month"
        },
        {
          "id": "sleep-month-load",
          "action": "sleep",
          "ms": 1500,
          "description": "Wait for the previous month's claim data to load"
        },
        {
          "id": "prev-assert-claimable-row",
          "action": "waitForSelector",
          "selector": "div:has(button:has-text('{{HMO_PROVIDER_NAME}} {{RUN_ID}}')) button:has-text('בחר הכל')",
          "description": "Assert that the previous month's lesson appears as a claimable row"
        },
        {
          "id": "screenshot-prev-month",
          "action": "screenshot",
          "name": "hmo-claims-tab-prev-month"
        },
        {
          "id": "prev-select-all",
          "action": "click",
          "selector": "div:has(button:has-text('{{HMO_PROVIDER_NAME}} {{RUN_ID}}')) button:has-text('בחר הכל')",
          "description": "Select all claimable rows for the HMO provider in the previous month"
        },
        {
          "id": "prev-wait-create-button",
          "action": "waitForSelector",
          "selector": "button:has-text('צור טיוטה מ')",
          "description": "Wait for the create-draft button to appear with a row count"
        },
        {
          "id": "prev-create-batch",
          "action": "click",
          "selector": "button:has-text('צור טיוטה מ')",
          "description": "Create the draft batch for previous month"
        },
        {
          "id": "prev-sleep-after-create",
          "action": "sleep",
          "ms": 1500,
          "description": "Wait for the batch to appear in the list"
        },
        {
          "id": "prev-assert-submit-visible",
          "action": "assert",
          "type": "visible",
          "selector": "button:has-text('שלח לגורם מממן')",
          "description": "Assert the newly created draft batch shows the submit button"
        },
        {
          "id": "prev-click-submit",
          "action": "click",
          "selector": "button:has-text('שלח לגורם מממן')",
          "first": true,
          "description": "Open the submit dialog for the previous-month draft batch"
        },
        {
          "id": "prev-wait-dialog",
          "action": "waitForSelector",
          "selector": "[role='dialog']",
          "description": "Wait for the submit dialog to open"
        },
        {
          "id": "prev-confirm-submit",
          "action": "click",
          "selector": "[role='dialog'] button:has-text('סמן כנשלח')",
          "description": "Confirm submission in the dialog"
        },
        {
          "id": "prev-wait-dialog-closed",
          "action": "waitForSelector",
          "selector": "[role='dialog']",
          "state": "hidden",
          "description": "Wait for the dialog to close after submission"
        },
        {
          "id": "prev-assert-no-submit",
          "action": "assert",
          "type": "visible",
          "selector": "button:has-text('שלח לגורם מממן')",
          "not": true,
          "description": "No more draft batches with a submit button remain in the previous month"
        },
        {
          "id": "screenshot-prev-submitted",
          "action": "screenshot",
          "name": "hmo-prev-month-submitted"
        }
      ]
    }
  ]
}
