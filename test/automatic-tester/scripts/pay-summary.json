            "employee_id": "{{SALARIED_INSTRUCTOR_ID}}",
            "pay_basis": "monthly_salary",
            "rate": 3000000,
            "effective_date": "2000-01-01",
            "replace_existing": true
          }
        },
        {
          "id": "half-day-leave",
          "description": "A paid half day on the sixth of last month; nothing else is recorded that day",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/employee-leave",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "employee_id": "{{SALARIED_INSTRUCTOR_ID}}",
            "leave_type": "employee_paid",
            "duration_mode": "half_day",
            "half_day_part": "first_half",
            "start_date": "{{PREV_MONTH_SIXTH_DAY}}",
            "end_date": "{{PREV_MONTH_SIXTH_DAY}}"
          }
        },
        {
          "id": "navigate-financials",
          "action": "navigate",
          "url": "{{BASE_URL}}/#/financials"
        },
        {
          "id": "wait-table",
          "action": "waitForSelector",
          "timeout": 90000,
          "selector": "[data-payroll-table]"
        },
        {
          "id": "previous-month",
          "action": "click",
          "selector": "main button:has-text('הקודם')",
          "first": true
        },
        {
          "id": "assert-tag",
          "description": "The amber tag with the count, on the employee's row",
          "action": "waitForSelector",
          "timeout": 90000,
          "selector": "[data-payroll-row='{{SALARIED_INSTRUCTOR_ID}}'] [data-payroll-tag='half_leave_no_hours']:has-text('חצי יום חופשה בלי שעות: 1')"
        },
        {
