          "endpoint": "/api/instructors",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "instructor_id": "{{SALARIED_INSTRUCTOR_ID}}",
            "working_days": [0, 1, 2, 3, 4, 5, 6]
          }
        },
        {
          "id": "seed-salary",
          "description": "A monthly salary from long ago, so it is in force on every day of last month",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/employee-rates",
          "body": {
