{
  "meta": {
    "id": "leave-pay-default",
    "name": "Settings — the organisation's default leave-pay method",
    "description": "The \"תשלום חופשה\" tile in the settings page. leave_pay_policy is a dated setting: every save is a version from a date. The policy is first reset to the seeded default (\"ממוצע מומלץ\", 3 months) from today through POST /api/settings; a write without effective_date is refused (400 missing_effective_date). The tile button opens the shared dialog with the form and \"שמירה\" disabled while nothing changed; the \"בתוקף מ-\" date starts at today; choosing \"ממוצע היסטורי\" and saving closes the dialog and shows it when reopened after a reload, with today's version in the \"היסטוריה (N)\" list; then \"ממוצע מומלץ\" is restored the same way. A write with 13 months is refused by the server (400 invalid_leave_pay_lookback_months).",
    "version": "1.1.0",
    "last_validated_at": "2026-11-16T12:00:00Z",
    "author": "claude-ai",
    "dependencies": {
      "routes": [
        "/Settings"
      ],
      "api_endpoints": [
        "GET /api/settings",
        "POST /api/settings"
      ]
    }
  },
  "config": {
    "timeout_ms": 25000,
    "screenshot_on_failure": true,
    "continue_on_step_failure": false,
    "continue_on_workflow_failure": false
  },
  "workflows": [
    {
      "id": "login",
      "name": "Login as Admin",
      "steps": [
        { "id": "do-login", "action": "login", "role": "admin" },
        { "id": "assert-dashboard", "action": "assert", "type": "url", "pattern": "#/dashboard" }
      ]
    },

    {
      "id": "api-reset-policy",
      "name": "API – Reset the policy to the seeded default and check the server refuses bad months",
      "steps": [
        {
          "id": "reset-policy",
          "description": "Store the seeded default from today (replacing today's version of an earlier run), so the run starts from \"ממוצע מומלץ\"",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/settings",
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "settings": {
              "leave_pay_policy": {
                "value": { "default_method": "legal", "lookback_months": 3, "legal_allow_12m_if_better": true, "fixed_rate_default": 0 },
                "effective_date": "{{TODAY}}"
              }
            }
          }
        },
        {
          "id": "refuse-without-date",
          "description": "A dated setting needs effective_date (400 missing_effective_date)",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/settings",
          "ignoreStatus": [400],
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "settings": {
              "leave_pay_policy": { "default_method": "avg_hourly_x_avg_day_hours", "lookback_months": 3, "legal_allow_12m_if_better": true }
            }
          }
        },
        {
          "id": "refuse-13-months",
          "description": "13 months is refused (400) — ignoreStatus only lets a 400 through; a 2xx would also pass, so the next workflow re-checks the stored value is still 3 months",
          "action": "apiCall",
          "method": "POST",
          "endpoint": "/api/settings",
          "ignoreStatus": [400],
          "body": {
            "org_id": "{{TEST_ORG_ID}}",
            "settings": {
              "leave_pay_policy": {
                "value": { "default_method": "legal", "lookback_months": 13, "legal_allow_12m_if_better": true },
                "effective_date": "{{TODAY}}"
              }
            }
          }
        }
      ]
    },

    {
      "id": "change-to-historic",
      "name": "UI – Open the tile's dialog, change the default to \"ממוצע היסטורי\", save, reopen, see it",
      "steps": [
        { "id": "navigate", "action": "navigate", "url": "{{BASE_URL}}/#/Settings" },
        {
          "id": "open-dialog",
          "description": "The \"תשלום חופשה\" tile opens the shared settings dialog",
          "action": "click",
          "selector": "button:has-text('פתיחת הגדרות תשלום חופשה')"
        },
        {
          "id": "wait-legal-selected",
          "description": "The form opens directly with the current values: \"ממוצע מומלץ\" chosen, 3 months (the 13-month write was refused)",
          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-settings-block='leave-pay-default'] #leave-pay-method-legal:checked"
        },
        {
          "id": "assert-months-3",
          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-settings-block='leave-pay-default'] #leave-pay-lookback-months[value='3']"
        },
        {
          "id": "assert-effective-today",
          "description": "\"בתוקף מ-\" starts at today",
          "action": "assert",
          "type": "value",
          "selector": "[role='dialog'] [data-dated-setting='leave-pay-default'] #leave-pay-default-effective-date",
          "value": "{{TODAY}}"
        },
        {
          "id": "assert-save-disabled",
          "description": "Nothing changed yet: \"שמירה\" is disabled",
          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-settings-block='leave-pay-default'] button:has-text('שמירה')[disabled]"
        },
        {
          "id": "assert-meanings-visible",
          "description": "Both methods show their meaning in words",
          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-settings-block='leave-pay-default'] label[for='leave-pay-method-avg_hourly_x_avg_day_hours']:has-text('ב-3 החודשים האחרונים בלבד')"
        },
        {
          "id": "choose-historic",
          "action": "click",
          "selector": "[role='dialog'] [data-settings-block='leave-pay-default'] label[for='leave-pay-method-avg_hourly_x_avg_day_hours']"
        },
        {
          "id": "save",
          "action": "click",
          "selector": "[role='dialog'] [data-settings-block='leave-pay-default'] button:has-text('שמירה'):not([disabled])"
        },
        {
          "id": "wait-dialog-closed",
          "action": "assert",
          "type": "hidden",
          "selector": "[role='dialog'] [data-settings-block='leave-pay-default']"
        },
        { "id": "reload", "action": "navigate", "url": "{{BASE_URL}}/#/dashboard" },
        { "id": "wait-dashboard", "action": "waitForURL", "pattern": "#/dashboard" },
        { "id": "back-to-settings", "action": "navigate", "url": "{{BASE_URL}}/#/Settings" },
        {
          "id": "reopen-dialog",
          "action": "click",
          "selector": "button:has-text('פתיחת הגדרות תשלום חופשה')"
        },
        {
          "id": "wait-historic-after-reload",
          "description": "After leaving and coming back the stored value is \"ממוצע היסטורי\"",
          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-settings-block='leave-pay-default'] #leave-pay-method-avg_hourly_x_avg_day_hours:checked"
        },
        {
          "id": "open-history",
          "description": "The versions list opens from \"היסטוריה (N)\"",
          "action": "click",
          "selector": "[role='dialog'] [data-dated-setting='leave-pay-default'] button:has-text('היסטוריה')"
        },
        {
          "id": "assert-today-in-history",
          "description": "Today's version is listed with its date and the method saved",
          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-dated-setting='leave-pay-default'] li:has-text('מ-{{TODAY_DISPLAY}}'):has-text('ממוצע היסטורי')"
        },
        {
          "id": "assert-first-version-in-history",
          "description": "The version carried over from before dated settings is shown as \"מאז ההתחלה\"",
          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-dated-setting='leave-pay-default'] li:has-text('מאז ההתחלה')"
        },
        { "id": "screenshot-historic", "action": "screenshot", "name": "01-leave-pay-default-historic" }
      ]
    },

    {
      "id": "restore-legal",
      "name": "UI – Restore \"ממוצע מומלץ\"",
      "steps": [
        {
          "id": "choose-legal",
          "action": "click",
          "selector": "[role='dialog'] [data-settings-block='leave-pay-default'] label[for='leave-pay-method-legal']"
        },
        {
          "id": "save",
          "action": "click",
          "selector": "[role='dialog'] [data-settings-block='leave-pay-default'] button:has-text('שמירה'):not([disabled])"
        },
        {
          "id": "wait-dialog-closed",
          "action": "assert",
          "type": "hidden",
          "selector": "[role='dialog'] [data-settings-block='leave-pay-default']"
        },
        { "id": "reload", "action": "navigate", "url": "{{BASE_URL}}/#/dashboard" },
        { "id": "wait-dashboard", "action": "waitForURL", "pattern": "#/dashboard" },
        { "id": "back-to-settings", "action": "navigate", "url": "{{BASE_URL}}/#/Settings" },
        {
          "id": "reopen-dialog",
          "action": "click",
          "selector": "button:has-text('פתיחת הגדרות תשלום חופשה')"
        },
        {
          "id": "wait-legal-after-reload",
          "action": "waitForSelector",
          "selector": "[role='dialog'] [data-settings-block='leave-pay-default'] #leave-pay-method-legal:checked"
        },
        { "id": "screenshot-legal", "action": "screenshot", "name": "02-leave-pay-default-legal" }
      ]
    },

    {
      "id": "logout",
      "name": "Logout",
      "steps": [
        { "id": "do-logout", "action": "logout" },
        { "id": "assert-login-page", "action": "assert", "type": "url", "pattern": "#/login" }
      ]
    }
  ]
}
