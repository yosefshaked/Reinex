# ─────────────────────────────────────────────────────────
# Reinex Automatic Tester — Environment Configuration
#
# TIP: You do NOT need to fill this in by hand.
# Run the auto-setup script instead:
#
#   1. supabase start           (start the local Supabase stack)
#   2. npm run dev              (start the Reinex app)
#   3. cd test/automatic-tester
#   4. npm install && npm run setup:browsers
#   5. node setup.js            (auto-discovers everything & writes .env)
#   6. node runner.js --all --headed
#
# Only fill this file in manually if auto-setup fails.
# ─────────────────────────────────────────────────────────

# Base URL of the running application (no trailing slash)
BASE_URL=http://localhost:4280

# ── Test User Credentials ──────────────────────────────────
# These accounts must already exist in the Supabase project.
# Each should belong to a test organisation.

# Owner / admin account (full access)
ADMIN_EMAIL=admin-test@example.com
ADMIN_PASSWORD=

# Office staff account
OFFICE_EMAIL=office-test@example.com
OFFICE_PASSWORD=

# Instructor / member account
INSTRUCTOR_EMAIL=instructor-test@example.com
INSTRUCTOR_PASSWORD=

# ── Test Organisation ──────────────────────────────────────
# The UUID of the test organisation all three accounts belong to.
# Leave blank to auto-select the first available organisation.
TEST_ORG_ID=

# ── Direct API Access ─────────────────────────────────────
# Service-role key (used for setup/teardown API calls that
# bypass RLS, e.g. seeding students before a test).
# NEVER commit this value.
SUPABASE_URL=http://127.0.0.1:54321
SERVICE_ROLE_KEY=

# ── Browser Options ───────────────────────────────────────
# Default browser: chromium | firefox | webkit
DEFAULT_BROWSER=chromium
# Default step timeout in milliseconds
DEFAULT_TIMEOUT_MS=12000
