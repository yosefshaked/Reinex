{
  "name": "reinex-automatic-tester",
  "version": "1.0.0",
  "description": "Browser-based automatic workflow testing for Reinex",
  "type": "module",
  "scripts": {
    "setup": "node setup.js",
    "setup:reset": "node setup.js --reset",
    "setup:browsers": "npx playwright install chromium --with-deps",
    "test": "node runner.js --all",
    "test:validate": "node runner.js --validate",
    "test:headed": "node runner.js --all --headed"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "playwright": "^1.44.0"
  }
}
